# Laravel API base URL — backend developer connects here
VITE_API_BASE_URL=http://localhost:8000/api

# WebSocket server URL (Laravel Echo / Pusher / custom WS)
VITE_WS_URL=ws://localhost:6001

# Enable floating chat widget on public pages
VITE_CHAT_WIDGET_ENABLED=true

# Admin inbox route protection is handled by Laravel — frontend only
VITE_CHAT_MOCK_MODE=true
